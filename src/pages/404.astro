---
import Base from '../layouts/Base.astro';
---
<Base noindex>
  <main class="hero" data-shape="target" data-side="center" data-scale=".8" data-opacity=".9">
    <div class="container hero-inner">
      <h1 class="hero-title"><span class="line"><span class="grad-red">404</span></span></h1>
      <p class="hero-intro" style="margin-top:24px">This page does not exist.</p>
      <div class="hero-ctas"><a class="btn btn-primary" href="/">Go to home page</a></div>
    </div>
  </main>
</Base>
